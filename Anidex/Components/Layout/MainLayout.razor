@inherits LayoutComponentBase
@inject Anidex.Services.ThemeService ThemeService

<div class="min-h-screen transition-colors duration-300 bg-zinc-50 text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100">
    <Header />

    <main>
        @Body
    </main>
</div>


@page "/"
@using Anidex.Components.Shared
@using Anidex.Models
@inject Anidex.Services.MediaService MediaService

<PageTitle>Anidex - Anime</PageTitle>

<div class="mx-auto max-w-7xl px-6 py-8">
    <div class="flex flex-col lg:flex-row gap-8">

        <!-- LEFT COLUMN (Main Content - 75% width) -->
        <div class="w-full lg:w-3/4 space-y-12">

            <!-- 1. Recommended Anime -->
            <section>
                <div class="flex items-center justify-between mb-4">
                    <h1 class="text-2xl font-bold text-zinc-900 dark:text-white">Recommended Anime</h1>
                    <a href="/anime" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">View All</a>
                </div>

                @if (_recommendedAnime == null)
                {
                    <div class="flex items-center justify-center py-12">
                        <div class="h-8 w-8 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"></div>
                        <span class="ml-3 text-zinc-400">Loading recommendations...</span>
                    </div>
                }
                else if (!_recommendedAnime.Any())
                {
                    <div class="rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-100 dark:bg-zinc-900 px-6 py-12 text-center text-zinc-400">
                        No recommendations found at the moment.
                    </div>
                }
                else
                {
                    <HorizontalCarousel Items="_recommendedAnime">
                        <ItemTemplate Context="anime">
                            <MediaCard Item="anime" />
                        </ItemTemplate>
                    </HorizontalCarousel>
                }
            </section>

            <!-- 2. Summer 2026 Anime -->
            <section>
                <h1 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Summer 2026 Anime</h1>

                <HorizontalCarousel Items="_summerAnime">
                    <ItemTemplate Context="anime">
                        <MediaCard Item="anime" />
                    </ItemTemplate>
                </HorizontalCarousel>
            </section>

            <!-- 3. Recently Added Anime -->
            <section>
                <h1 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Recently Added</h1>

                <HorizontalCarousel Items="_recentlyAdded">
                    <ItemTemplate Context="anime">
                        <MediaCard Item="anime" />
                    </ItemTemplate>
                </HorizontalCarousel>
            </section>

        </div>

        <!-- RIGHT COLUMN (Sidebar - 25% width) -->
        <div class="w-full lg:w-1/4 space-y-6">
            <TopTenList Title="Top Airing Anime" Items="_topAiring" />
            <TopTenList Title="Most Popular" Items="_mostPopular" />
        </div>

    </div>
</div>

@code {
    private List<Media>? _recommendedAnime;

    private List<Media> _summerAnime = new()
    {
        new Media { Id = "placeholder:1", Source = "MAL", Title = "Placeholder Summer Anime 1", CoverImage = null, Score = 8.2 },
        new Media { Id = "placeholder:2", Source = "MAL", Title = "Placeholder Summer Anime 2", CoverImage = null, Score = 7.9 },
        new Media { Id = "placeholder:3", Source = "MAL", Title = "Placeholder Summer Anime 3", CoverImage = null, Score = 8.5 },
    };

    private List<Media> _recentlyAdded = new()
    {
        new Media { Id = "placeholder:4", Source = "MAL", Title = "Placeholder Recent Anime 1", CoverImage = null },
        new Media { Id = "placeholder:5", Source = "MAL", Title = "Placeholder Recent Anime 2", CoverImage = null },
    };

    private List<RankedMediaItem> _topAiring = new()
    {
        new RankedMediaItem { Rank = 1, Title = "Placeholder Airing 1", Subtitle = "TV, 19 eps, scored 9.15", DetailsUrl = "#" },
        new RankedMediaItem { Rank = 2, Title = "Placeholder Airing 2", Subtitle = "TV, 12 eps, scored 8.90", DetailsUrl = "#" },
    };

    private List<RankedMediaItem> _mostPopular = new()
    {
        new RankedMediaItem { Rank = 1, Title = "Placeholder Popular 1", Subtitle = "301,411 members", DetailsUrl = "#" },
        new RankedMediaItem { Rank = 2, Title = "Placeholder Popular 2", Subtitle = "224,910 members", DetailsUrl = "#" },
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _recommendedAnime = await MediaService.GetRecommendedAnimeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching recommendations: {ex.Message}");
            _recommendedAnime = new List<Media>();
        }
    }
}
@page "/media/{id}"
@page "/visual-novels/{VnId}"
@rendermode InteractiveServer
@using Anidex.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject Anidex.Services.MediaService MediaService
@inject Anidex.Services.CommentService CommentService
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient HttpClient

<PageTitle>@(_details?.Title ?? "Loading...") - Anidex</PageTitle>

<div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">

    @if (_errorMessage != null)
    {
        <div class="mx-auto max-w-2xl rounded-2xl bg-red-500/10 border border-red-500/20 p-6 text-center my-12 shadow-xl backdrop-blur-md">
            <div class="flex flex-col items-center gap-3">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-500/10 text-red-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <p class="font-semibold text-red-600 dark:text-red-400">@_errorMessage</p>
                @if (_isAdultContentError)
                {
                    <p class="text-xs text-red-500/80">This content is restricted to users 18+. Comments are disabled for this content.</p>
                }
                <button @onclick="RetryAsync" class="mt-2 text-xs font-semibold uppercase tracking-wider text-red-600 dark:text-red-400 hover:underline">
                    Try again
                </button>
            </div>
        </div>
    }
    else if (_details == null)
    {
        <div class="flex flex-col items-center justify-center py-32 space-y-4">
            <div class="h-10 w-10 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"></div>
            <span class="text-sm font-medium text-zinc-400">Fetching media details...</span>
        </div>
    }
    else
    {
        <!-- Main Media Overview Card -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start rounded-3xl border border-zinc-200 bg-white p-6 sm:p-8 shadow-xl dark:border-white/10 dark:bg-zinc-900/90 backdrop-blur-md">

            <!-- Poster Column -->
            <div class="md:col-span-4 flex flex-col items-center">
                <div class="relative overflow-hidden rounded-2xl bg-zinc-200 dark:bg-zinc-800 shadow-2xl w-full max-w-[280px] aspect-[3/4] group">
                    @if (!string.IsNullOrEmpty(_details.CoverImage))
                    {
                        <img src="@_details.CoverImage" alt="@_details.Title" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
                    }
                    else
                    {
                        <div class="flex h-full w-full items-center justify-center text-zinc-400 dark:text-zinc-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_details.ExternalUrl))
                {
                    <a href="@_details.ExternalUrl" target="_blank" rel="noreferrer" class="mt-6 inline-flex w-full max-w-[280px] items-center justify-center gap-2 rounded-xl border border-blue-200 bg-blue-50/50 px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-blue-600 transition hover:bg-blue-600 hover:text-white dark:border-blue-500/20 dark:bg-blue-500/10 dark:text-blue-400 dark:hover:bg-blue-600 dark:hover:text-white">
                        <span>View on VNDB</span>
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                }
            </div>

            <!-- Details Column -->
            <div class="md:col-span-8 space-y-6">
                <div>
                    <h1 tabindex="-1" class="text-3xl sm:text-4xl font-extrabod tracking-tight text-zinc-900 dark:text-white outline-none focus:outline-none">
                        @_details.Title
                    </h1>

                    @if (!string.IsNullOrWhiteSpace(_details.AlternativeTitle))
                    {
                        <p class="mt-1 text-base font-medium text-zinc-500 dark:text-zinc-400">@_details.AlternativeTitle</p>
                    }
                </div>

                <!-- Stats Grid -->
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                    @if (_details.Score.HasValue)
                    {
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-3.5 dark:border-white/10 dark:bg-zinc-950/50">
                            <p class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Score</p>
                            <p class="mt-0.5 text-xl font-black text-amber-500 flex items-center gap-1">
                                <span>★</span> @_details.Score.Value.ToString("0.0")
                            </p>
                        </div>
                    }
                    @if (_details.VoteCount.HasValue)
                    {
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-3.5 dark:border-white/10 dark:bg-zinc-950/50">
                            <p class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Votes</p>
                            <p class="mt-0.5 text-xl font-black text-zinc-900 dark:text-white">@_details.VoteCount.Value.ToString("N0")</p>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_details.Released))
                    {
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-3.5 dark:border-white/10 dark:bg-zinc-950/50">
                            <p class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Released</p>
                            <p class="mt-0.5 text-base font-bold text-zinc-900 dark:text-white truncate">@_details.Released</p>
                        </div>
                    }
                    @if (_details.LengthMinutes.HasValue)
                    {
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-3.5 dark:border-white/10 dark:bg-zinc-950/50">
                            <p class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Play Time</p>
                            <p class="mt-0.5 text-base font-bold text-zinc-900 dark:text-white">@FormatPlayTime(_details.LengthMinutes.Value)</p>
                        </div>
                    }
                </div>

                <!-- Synopsis -->
                <div>
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">Synopsis</h2>
                    <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-300 whitespace-pre-line">
                        @_details.Description
                    </p>
                </div>

                <!-- VN Metadata Badges -->
                @if (IsVisualNovel && (_details.Developers.Any() || _details.Languages.Any() || _details.Platforms.Any() || _details.Tags.Any()))
                {
                    <div class="space-y-4 border-t border-zinc-100 pt-4 dark:border-white/5 text-xs">
                        @if (_details.Developers.Any())
                        {
                            <div>
                                <span class="font-semibold uppercase tracking-wider text-zinc-500">Developers: </span>
                                <span class="font-medium text-zinc-900 dark:text-white">@string.Join(", ", _details.Developers)</span>
                            </div>
                        }
                        @if (_details.Languages.Any())
                        {
                            <div>
                                <span class="font-semibold uppercase tracking-wider text-zinc-500">Languages: </span>
                                <span class="font-medium text-zinc-900 dark:text-white">@string.Join(", ", _details.Languages)</span>
                            </div>
                        }
                        @if (_details.Platforms.Any())
                        {
                            <div>
                                <span class="font-semibold uppercase tracking-wider text-zinc-500">Platforms: </span>
                                <span class="font-medium text-zinc-900 dark:text-white">@string.Join(", ", _details.Platforms)</span>
                            </div>
                        }
                        @if (_details.Tags.Any())
                        {
                            <div class="pt-2">
                                <span class="block font-semibold uppercase tracking-wider text-zinc-500 mb-2">Tags</span>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var tag in _details.Tags)
                                    {
                                        <span class="rounded-lg border border-blue-200/50 bg-blue-50/50 px-2.5 py-1 text-xs text-blue-700 dark:border-blue-500/20 dark:bg-blue-500/10 dark:text-blue-300">
                                            @tag
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Characters Pills -->
                @if (_details.Characters.Any())
                {
                    <div class="border-t border-zinc-100 pt-4 dark:border-white/5">
                        <span class="block text-xs font-semibold uppercase tracking-wider text-zinc-500 mb-2">Characters</span>
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var charName in _details.Characters)
                            {
                                <span class="rounded-lg border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs text-zinc-700 dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-300">
                                    @charName
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Comments Section -->
        <div class="mt-12 rounded-3xl border border-zinc-200 bg-white p-6 sm:p-8 shadow-xl dark:border-white/10 dark:bg-zinc-900/90 backdrop-blur-md">
            <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white mb-6">Discussion</h2>

            @if (!_isAdultContentError)
            {
                <AuthorizeView>
                    <Authorized>
                        <div class="mb-8 rounded-2xl border border-zinc-200 bg-zinc-50/50 p-4 dark:border-zinc-800 dark:bg-zinc-950/50">
                            <div class="flex flex-col gap-3">
                                <textarea @bind="_newCommentContent"
                                          placeholder="Share your thoughts about this title..."
                                          rows="3"
                                          class="w-full rounded-xl border border-zinc-200 bg-white p-4 text-sm text-zinc-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-zinc-800 dark:bg-zinc-900 dark:text-white dark:placeholder-zinc-500"></textarea>

                                @if (!string.IsNullOrEmpty(_newCommentError))
                                {
                                    <p class="text-xs font-medium text-red-600 dark:text-red-400">@_newCommentError</p>
                                }

                                <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
                                    <div class="flex items-center gap-2">
                                        <InputFile OnChange="HandleFileUpload" class="hidden" />
                                        <label class="cursor-pointer rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs font-semibold text-zinc-700 transition hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800">
                                            Attach Image
                                        </label>
                                        @if (!string.IsNullOrEmpty(_uploadedMediaUrl))
                                        {
                                            <span class="text-xs text-emerald-500 font-medium">✓ Image attached</span>
                                        }
                                    </div>
                                    <button @onclick="PostComment" disabled="@_isPosting" class="rounded-xl bg-blue-600 px-5 py-2 text-sm font-semibold text-white shadow-md transition hover:bg-blue-500 active:scale-95 disabled:cursor-not-allowed disabled:opacity-60">
                                        @(_isPosting ? "Posting…" : "Post Comment")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="mb-8 rounded-2xl border border-zinc-200 bg-zinc-50 p-6 text-center text-sm text-zinc-500 dark:border-zinc-800 dark:bg-zinc-950">
                            Please <a href="/Account/Login" class="font-semibold text-blue-600 hover:underline dark:text-blue-400">log in</a> to participate in the comments.
                        </div>
                    </NotAuthorized>
                </AuthorizeView>

                <!-- Comments List -->
                <div class="space-y-4">
                    @if (_comments == null)
                    {
                        <div class="flex justify-center py-8">
                            <div class="h-6 w-6 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"></div>
                        </div>
                    }
                    else if (!_comments.Any())
                    {
                        <p class="py-8 text-center text-sm text-zinc-400">No comments yet. Be the first to share your thoughts!</p>
                    }
                    else
                    {
                        @foreach (var comment in _comments)
                        {
                            var isEditing = _editingCommentId.HasValue && _editingCommentId.Value == comment.Id;
                            <div class="flex gap-4 rounded-2xl border border-zinc-100 bg-zinc-50/50 p-4 dark:border-white/5 dark:bg-zinc-950/40">
                                <!-- User Avatar Placeholder -->
                                <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-blue-500/10 text-sm font-bold text-blue-500">
                                    @(comment.UserName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                                </div>

                                <div class="flex-1 min-w-0">
                                    @if (isEditing)
                                    {
                                        <!-- Edit Mode -->
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-sm font-bold text-zinc-900 dark:text-white truncate">@comment.UserName</span>
                                            <span class="text-xs text-zinc-400">@comment.CreatedAt.ToLocalTime().ToString("g")</span>
                                        </div>

                                        <textarea @bind="_editedContent"
                                                  class="w-full mb-2 p-2 border border-zinc-200 rounded bg-white text-zinc-900 dark:bg-zinc-800 dark:text-white"
                                                  rows="3"></textarea>

                                        @if (!string.IsNullOrEmpty(_editError))
                                        {
                                            <p class="text-xs font-medium text-red-600 dark:text-red-400 mb-2">@_editError</p>
                                        }

                                        <div class="flex justify-end gap-2">
                                            <button @onclick="() => SaveEdit(comment.Id)" class="rounded bg-blue-600 px-3 py-1 text-sm font-semibold text-white hover:bg-blue-500">
                                                Save
                                            </button>
                                            <button @onclick="() => CancelEdit()" class="rounded bg-gray-500 px-3 py-1 text-sm font-semibold text-white hover:bg-gray-400">
                                                Cancel
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- View Mode -->
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-sm font-bold text-zinc-900 dark:text-white truncate">@comment.UserName</span>
                                            <span class="text-xs text-zinc-400">@comment.CreatedAt.ToLocalTime().ToString("g")</span>
                                        </div>

                                        <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-300 mb-3 whitespace-pre-line">@comment.Content</p>

                                        @if (!string.IsNullOrEmpty(comment.MediaUrl))
                                        {
                                            <div class="mb-3">
                                                <img src="@comment.MediaUrl" class="max-w-xs rounded-xl border border-zinc-200 shadow-sm dark:border-white/10" />
                                            </div>
                                        }

                                        <div class="flex items-center gap-4">
                                            <button @onclick="() => AgreeComment(comment.Id)" class="flex items-center gap-1 text-xs font-medium text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400 transition">
                                                <span>Agree</span>
                                                <span class="rounded-full bg-zinc-200/60 px-1.5 py-0.5 text-[10px] dark:bg-zinc-800">@comment.AgreeCount</span>
                                            </button>

                                            <AuthorizeView>
                                                <Authorized Context="authContext">
                                                    @if (authContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == comment.UserId)
                                                    {
                                                        <button @onclick="() => StartEdit(comment.Id)" class="text-xs font-medium text-zinc-400 hover:text-blue-600 transition">
                                                            Edit
                                                        </button>
                                                        <button @onclick="() => DeleteComment(comment.Id)" class="text-xs font-medium text-zinc-400 hover:text-red-500 transition">
                                                            Delete
                                                        </button>
                                                    }
                                                </Authorized>
                                            </AuthorizeView>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 text-center text-sm text-zinc-500 dark:border-zinc-800 dark:bg-zinc-950">
                    Comments are disabled for restricted content.
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? VnId { get; set; }
    private Anidex.Services.MediaDetails? _details;
    private List<Anidex.Models.Comment>? _comments;
    private string _newCommentContent = "";
    private string? _uploadedMediaUrl;
    private string? _errorMessage;
    private bool _isAdultContentError = false;

    // Comment action errors (rendered under the composer / edit form)
    private string? _newCommentError;
    private string? _editError;

    // Tracks an in-flight post so the button can be disabled and we don't
    // fire duplicate requests on rapid clicks.
    private bool _isPosting;

    private string? MediaId => !string.IsNullOrWhiteSpace(Id)
        ? Id
        : !string.IsNullOrWhiteSpace(VnId) ? $"vndb:{VnId}" : null;
    private bool IsVisualNovel => _details?.Source == "VNDB";

    // Edit state
    private Guid? _editingCommentId;
    private string _editedContent = "";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task RetryAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _details = null;
        _comments = null;
        _errorMessage = null;
        _isAdultContentError = false;

        if (MediaId == null)
        {
            _errorMessage = "No media item was specified.";
            return;
        }

        try
        {
            _details = await MediaService.GetMediaDetailsAsync(MediaId);
            await LoadComments();
        }
        catch (NotAllowedException ex)
        {
            Console.WriteLine($"Access denied: {ex.Message}");
            _errorMessage = ex.Message;
            _isAdultContentError = true;
        }
        catch (MalApiException ex)
        {
            // Upstream non-2xx from Jikan (e.g. 404, 502). The exception message
            // already includes the status code, so the user sees the actual
            // cause instead of a generic "Gateway Error".
            Console.WriteLine($"[MediaDetails] upstream error: {ex.Message}");
            _errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            // Transport-level failure (DNS, TCP, Polly timeout, etc.).
            Console.WriteLine($"[MediaDetails] transport error: {ex.Message}");
            _errorMessage = $"Network error talking to upstream API: {ex.Message}";
        }
        catch (Polly.Timeout.TimeoutRejectedException ex)
        {
            // Polly's per-request TimeoutAsync (10s on MalService / VNDBService) fires here.
            // Without this branch the user sees a generic "Something went wrong" instead
            // of a hint that the upstream is slow.
            Console.WriteLine($"[MediaDetails] upstream timeout: {ex.Message}");
            _errorMessage = "Jikan is slow right now — please retry in a moment.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MediaDetails] unexpected error: {ex}");
            _errorMessage = "We encountered a problem fetching the media details. This might be due to API rate limits or an invalid ID.";
        }
    }

    private async Task LoadComments()
    {
        if (MediaId != null && !_isAdultContentError)
        {
            _comments = await CommentService.GetCommentsAsync(MediaId);
        }
        else
        {
            _comments = new List<Anidex.Models.Comment>();
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
        {
            _uploadedMediaUrl = null;
            return;
        }

        // Validate file type (allow images only)
        var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp" };
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (!allowedExtensions.Contains(extension))
        {
            _errorMessage = "Invalid file type. Please upload an image (JPG, PNG, GIF, BMP, WEBP).";
            return;
        }

        // Validate file size (limit to 5 MB)
        const long maxSize = 5 * 1024 * 1024; // 5 MB
        if (file.Size > maxSize)
        {
            _errorMessage = $"File size exceeds the limit of {maxSize / (1024 * 1024)} MB.";
            return;
        }

        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = file.OpenReadStream(maxSize);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var response = await HttpClient.PostAsync("api/upload", content);
            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = $"Upload failed: {response.StatusCode}";
                return;
            }

            var uploadResult = await response.Content.ReadFromJsonAsync<UploadResponse>();
            if (uploadResult == null || string.IsNullOrEmpty(uploadResult.Url))
            {
                _errorMessage = "Upload failed: Invalid response from server.";
                return;
            }

            _uploadedMediaUrl = uploadResult.Url;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MediaDetails] Upload error: {ex.Message}");
            _errorMessage = $"Upload failed: {ex.Message}";
        }
    }

    private async Task PostComment()
    {
        if (_isPosting) return; // guard against re-entry on rapid clicks
        if (string.IsNullOrWhiteSpace(_newCommentContent)) return;
        if (_isAdultContentError) return;

        _isPosting = true;
        _newCommentError = null;

        try
        {
            Console.WriteLine("[MediaDetails] PostComment invoked");

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? user.Identity?.Name ?? "unknown";
            var userName = user.Identity?.Name ?? "Anonymous";

            var comment = new Anidex.Models.Comment
            {
                UserId = userId,
                UserName = userName,
                MediaId = MediaId ?? string.Empty,
                Content = _newCommentContent,
                // MediaUrl is intentionally optional — null when no image was attached.
                MediaUrl = string.IsNullOrWhiteSpace(_uploadedMediaUrl) ? null : _uploadedMediaUrl
            };

            await CommentService.AddCommentAsync(comment);
            Console.WriteLine($"[MediaDetails] Comment posted (MediaId={comment.MediaId}, hasImage={comment.MediaUrl != null})");

            _newCommentContent = "";
            _uploadedMediaUrl = null;
            await LoadComments();
        }
        catch (UnauthorizedAccessException ex)
        {
            _newCommentError = ex.Message;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MediaDetails] PostComment error: {ex.Message}");
            _newCommentError = "Failed to post comment: " + ex.Message;
        }
        finally
        {
            _isPosting = false;
        }
    }

    private async Task AgreeComment(Guid id)
    {
        await CommentService.IncrementAgreeCountAsync(id);
        await LoadComments();
    }

    private async Task DeleteComment(Guid id)
    {
        _editError = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? authState.User.Identity?.Name ?? "unknown";

        try
        {
            await CommentService.DeleteCommentAsync(id, userId);
            await LoadComments();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MediaDetails] DeleteComment error: {ex.Message}");
            _editError = "Delete failed: " + ex.Message;
        }
    }

    // Edit methods
    private void StartEdit(Guid commentId)
    {
        var comment = _comments?.FirstOrDefault(c => c.Id == commentId);
        if (comment != null)
        {
            _editingCommentId = commentId;
            _editedContent = comment.Content;
        }
    }

    private async Task SaveEdit(Guid commentId)
    {
        if (!_editingCommentId.HasValue || _editingCommentId.Value != commentId) return;

        _editError = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? user.Identity?.Name ?? "unknown";

        try
        {
            await CommentService.UpdateCommentAsync(commentId, _editedContent, userId);

            _editingCommentId = null;
            _editedContent = "";
            await LoadComments();
        }
        catch (UnauthorizedAccessException ex)
        {
            _editError = ex.Message;
        }
        catch (KeyNotFoundException ex)
        {
            _editError = ex.Message;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MediaDetails] SaveEdit error: {ex.Message}");
            _editError = "Edit failed: " + ex.Message;
        }
    }

    private void CancelEdit()
    {
        _editingCommentId = null;
        _editedContent = "";
    }

    private static string FormatPlayTime(int minutes)
    {
        var duration = TimeSpan.FromMinutes(minutes);
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}h {duration.Minutes}m"
            : $"{duration.Minutes}m";
    }


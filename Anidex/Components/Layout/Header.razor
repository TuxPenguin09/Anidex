@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject Anidex.Services.ThemeService ThemeService

<header class="sticky top-0 z-50 border-b border-white/10 bg-zinc-950/80 backdrop-blur-md dark:bg-zinc-950/80 bg-white/80 dark:bg-zinc-950/80 border-zinc-200 dark:border-white/10 transition-colors duration-300">
    <div class="mx-auto max-w-7xl px-6 py-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3 md:gap-8">
                <a href="/" class="text-2xl font-bold text-blue-600 dark:text-blue-400 transition hover:text-blue-500 dark:hover:text-blue-300">
                    Anidex
                </a>

                <button @onclick="ToggleMobileMenu"
                        class="flex h-9 w-9 items-center justify-center rounded-full bg-zinc-200 text-zinc-700 transition hover:bg-zinc-300 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 md:hidden"
                        type="button"
                        aria-label="Toggle navigation menu"
                        title="Menu">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>

                <nav class="items-center gap-6 text-sm font-medium text-zinc-500 dark:text-zinc-400 md:flex">
                    <a href="/anime" class="transition hover:text-zinc-900 dark:hover:text-white">Anime</a>
                    <a href="/visual-novels" class="transition hover:text-zinc-900 dark:hover:text-white">Visual Novels</a>
                    <AuthorizeView>
                        <Authorized>
                            <a href="/my-list" class="transition hover:text-zinc-900 dark:hover:text-white">My List</a>
                        </Authorized>
                    </AuthorizeView>
                </nav>
            </div>

            <div class="flex items-center gap-4">
                <div class="relative group hidden sm:block">
                    <input type="text"
                           placeholder="Search..."
                           class="w-48 rounded-full bg-zinc-100 dark:bg-zinc-900 px-4 py-1.5 text-sm text-zinc-900 dark:text-white placeholder-zinc-500 transition focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:w-64" />
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </span>
                </div>

                <button @onclick="ToggleTheme"
                        class="flex h-9 w-9 items-center justify-center rounded-full bg-zinc-200 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 transition hover:bg-zinc-300 dark:hover:bg-zinc-700 hover:text-zinc-900 dark:hover:text-white"
                        title="Toggle Theme">
                    @if (ThemeService.IsDarkMode)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 5a7 7 0 00-7 7h14a7 7 0 00-7 7z" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                        </svg>
                    }
                </button>

                <nav class="flex items-center gap-3 border-l border-zinc-200 dark:border-white/10 pl-4">
                    <AuthorizeView>
                        <Authorized Context="authState">
                            <span class="text-sm text-zinc-500 dark:text-zinc-400">[@GetUserDisplayName(authState.User)]</span>
                            <form action="/Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="returnUrl" value="" />
                                <button type="submit"
                                        class="rounded-lg bg-zinc-200 px-4 py-2 text-sm font-medium transition hover:bg-zinc-300 dark:bg-zinc-800 dark:text-white dark:hover:bg-zinc-700">
                                    Logout
                                </button>
                            </form>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/Account/Join"
                               class="rounded-lg px-4 py-2 text-sm transition hover:bg-zinc-100 dark:hover:bg-white/10 text-zinc-900 dark:text-white">
                                Join
                            </a>

                            <a href="/Account/Login"
                               class="rounded-lg bg-blue-600 px-5 py-2 text-sm font-medium transition duration-200 hover:bg-blue-500 hover:shadow-lg hover:shadow-blue-500/30 text-white">
                                Login
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </nav>
            </div>
        </div>

        @if (_isMobileMenuOpen)
        {
            <nav class="mt-3 flex flex-col gap-3 border-t border-zinc-200 pt-3 text-sm font-medium text-zinc-600 dark:border-white/10 dark:text-zinc-300 md:hidden">
                <a href="/anime" class="transition hover:text-zinc-900 dark:hover:text-white" @onclick="CloseMobileMenu">Anime</a>
                <a href="/visual-novels" class="transition hover:text-zinc-900 dark:hover:text-white" @onclick="CloseMobileMenu">Visual Novels</a>
                <AuthorizeView>
                    <Authorized>
                        <a href="/my-list" class="transition hover:text-zinc-900 dark:hover:text-white" @onclick="CloseMobileMenu">My List</a>
                    </Authorized>
                </AuthorizeView>
            </nav>
        }
    </div>
</header>

@code {
    private bool _isMobileMenuOpen;

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
    }

    private void ToggleMobileMenu()
    {
        _isMobileMenuOpen = !_isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        _isMobileMenuOpen = false;
    }

    private static string GetUserDisplayName(ClaimsPrincipal user)
    {
        return user.Identity?.Name ?? "username";
    }
}

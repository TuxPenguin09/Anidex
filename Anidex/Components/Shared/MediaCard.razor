@using Anidex.Models

<a href="@DetailsUrl" class="group snap-start flex flex-col overflow-hidden rounded-lg bg-zinc-100 dark:bg-zinc-900 transition-all duration-300 hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:shadow-xl hover:-translate-y-2" style="flex: 0 0 12rem; width: 12rem;">
    <div class="overflow-hidden bg-zinc-200 dark:bg-zinc-800" style="aspect-ratio: 3 / 4;">
        @if (!string.IsNullOrEmpty(Item.CoverImage))
        {
            <img src="@Item.CoverImage" alt="@Item.Title" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" class="transition duration-500 group-hover:scale-110" />
        }
        else
        {
            <div class="flex items-center justify-center text-zinc-400 dark:text-zinc-600" style="width: 100%; height: 100%;">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 00-2 2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
            </div>
        }
    </div>
    <div class="p-3">
        <h3 class="line-clamp-2 text-sm font-medium text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400">
            @Item.Title
        </h3>
        <div class="mt-1 flex items-center justify-between">
            <span class="rounded bg-zinc-200 px-1.5 py-0.5 text-xs font-semibold text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">@Item.Source</span>
            @if (Item.Score.HasValue)
            {
                <span class="text-xs font-bold text-yellow-600 dark:text-yellow-500">★ @Item.Score.Value.ToString("0.0")</span>
            }
        </div>
        @if (Item.Source == "VNDB" && !string.IsNullOrWhiteSpace(Item.Released))
        {
            <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">Released @Item.Released</p>
        }
    </div>
</a>

@code {
    [Parameter] public Media Item { get; set; } = default!;

    private string DetailsUrl => Item.Source == "VNDB" && Item.Id.StartsWith("vndb:", StringComparison.OrdinalIgnoreCase)
        ? $"/visual-novels/{Item.Id["vndb:".Length..]}"
        : $"/media/{Item.Id}";
}

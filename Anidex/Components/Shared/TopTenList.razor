@using Anidex.Models

<div class="rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-zinc-900/50 p-4">
    <h2 class="mb-4 text-lg font-bold text-zinc-900 dark:text-white">@Title</h2>
    <ol class="space-y-3">
        @foreach (var item in Items)
        {
            <li class="flex items-center gap-3">
                <span class="w-5 flex-shrink-0 text-center text-sm font-bold text-zinc-400">@item.Rank</span>
                <a href="@item.DetailsUrl" class="flex-shrink-0 overflow-hidden rounded bg-zinc-200 dark:bg-zinc-800" style="width:42px; height:56px;">
                    @if (!string.IsNullOrEmpty(item.CoverImage))
                    {
                        <img src="@item.CoverImage" alt="@item.Title" style="width:100%; height:100%; object-fit:cover;" />
                    }
                </a>
                <div class="min-w-0">
                    <a href="@item.DetailsUrl" class="line-clamp-2 text-sm font-semibold text-white hover:text-blue-400 transition">
                        @item.Title
                    </a>
                    <p class="text-xs text-zinc-400 mt-0.5">@item.Subtitle</p>
                </div>
            </li>
        }
    </ol>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public List<RankedMediaItem> Items { get; set; } = new();
}
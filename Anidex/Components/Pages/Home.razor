@page "/"
@using Anidex.Components.Shared
@inject Anidex.Services.MediaService MediaService

<PageTitle>Home</PageTitle>

<div class="mx-auto max-w-7xl px-6 py-8">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-bold text-zinc-900 dark:text-white">Recommended Anime</h1>
        <a href="/anime" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">View All</a>
    </div>

    @if (_recommendedAnime == null)
    {
        <div class="flex items-center justify-center py-12">
            <div class="h-8 w-8 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"></div>
            <span class="ml-3 text-zinc-400">Loading recommendations...</span>
        </div>
    }
    else if (!_recommendedAnime.Any())
    {
        <div class="rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-100 dark:bg-zinc-900 px-6 py-12 text-center text-zinc-400">
            No recommendations found at the moment.
        </div>
    }
    else
    {
        <div class="relative overflow-hidden" style="max-width: 100%;">
            <div class="flex gap-6 pb-6 snap-x scroll-smooth no-scrollbar" style="overflow-x: auto; overflow-y: hidden; width: 100%; max-width: 100%;">
                @foreach (var anime in _recommendedAnime)
                {
                    <MediaCard Item="anime" />
                }
            </div>
        </div>
    }

    <div class="flex items-center justify-between mb-8 mt-12">
        <h1 class="text-3xl font-bold text-zinc-900 dark:text-white">Recommended Visual Novels</h1>
        <a href="/visual-novels" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">View All</a>
    </div>

    @if (_recommendedVNs == null)
    {
        <div class="flex items-center justify-center py-12">
            <div class="h-8 w-8 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"></div>
            <span class="ml-3 text-zinc-400">Loading recommendations...</span>
        </div>
    }
    else if (!_recommendedVNs.Any())
    {
        <div class="rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-100 dark:bg-zinc-900 px-6 py-12 text-center text-zinc-400">
            No recommendations found at the moment.
        </div>
    }
    else
    {
        <div class="relative overflow-hidden" style="max-width: 100%;">
            <div class="flex gap-6 pb-6 snap-x scroll-smooth no-scrollbar" style="overflow-x: auto; overflow-y: hidden; width: 100%; max-width: 100%;">
                @foreach (var vn in _recommendedVNs)
                {
                    <MediaCard Item="vn" />
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Anidex.Models.Media>? _recommendedAnime;
    private List<Anidex.Models.Media>? _recommendedVNs;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _recommendedAnime = await MediaService.GetRecommendedAnimeAsync();
            _recommendedVNs = await MediaService.GetRecommendedVisualNovelsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching recommendations: {ex.Message}");
            _recommendedAnime = new List<Anidex.Models.Media>();
            _recommendedVNs = new List<Anidex.Models.Media>();
        }
    }
}

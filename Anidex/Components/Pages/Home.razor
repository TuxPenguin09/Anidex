@page "/"
@using Anidex.Components.Shared
@using Anidex.Models
@inject Anidex.Services.MediaService MediaService

<PageTitle>Anidex - Anime</PageTitle>

<div class="mx-auto max-w-7xl px-6 py-8">
    <div class="flex flex-col lg:flex-row gap-8">

        <!-- LEFT COLUMN (Main Content - 75% width) -->
        <div class="w-full lg:w-3/4 space-y-12">

            <!-- 1. Recommended Anime -->
            <section>
                <div class="flex items-center justify-between mb-4">
                    <h1 class="text-2xl font-bold text-zinc-900 dark:text-white">Recommended Anime</h1>
                    <a href="/anime" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">View All</a>
                </div>

                @if (_recommendedLoading)
                {
                    <div class="flex items-center justify-center py-12">
                        <div class="h-8 w-8 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"></div>
                        <span class="ml-3 text-zinc-400">Loading recommendations...</span>
                    </div>
                }
                else if (!_recommendedAnime.Any())
                {
                    <div class="rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-100 dark:bg-zinc-900 px-6 py-12 text-center text-zinc-400">
                        No recommendations found at the moment.
                    </div>
                }
                else
                {
                    <HorizontalCarousel Items="_recommendedAnime">
                        <ItemTemplate Context="anime">
                            <MediaCard Item="anime" />
                        </ItemTemplate>
                    </HorizontalCarousel>
                }
            </section>

            <!-- 2. Summer 2026 Anime -->
            <section>
                <div class="flex items-center justify-between mb-4">
                    <h1 class="text-2xl font-bold text-zinc-900 dark:text-white">Summer 2026 Anime</h1>
                </div>

                @if (_summerLoading)
                {
                    <div class="flex items-center justify-center py-12">
                        <div class="h-8 w-8 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"></div>
                        <span class="ml-3 text-zinc-400">Loading summer anime...</span>
                    </div>
                }
                else if (!_summerAnime.Any())
                {
                    <div class="rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-100 dark:bg-zinc-900 px-6 py-12 text-center text-zinc-400">
                        No summer anime available right now.
                    </div>
                }
                else
                {
                    <HorizontalCarousel Items="_summerAnime">
                        <ItemTemplate Context="anime">
                            <MediaCard Item="anime" />
                        </ItemTemplate>
                    </HorizontalCarousel>
                }
            </section>

            <!-- 3. Recently Added Anime -->
            <section>
                <div class="flex items-center justify-between mb-4">
                    <h1 class="text-2xl font-bold text-zinc-900 dark:text-white">Recently Added</h1>
                </div>

                @if (_recentLoading)
                {
                    <div class="flex items-center justify-center py-12">
                        <div class="h-8 w-8 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"></div>
                        <span class="ml-3 text-zinc-400">Loading recently added...</span>
                    </div>
                }
                else if (!_recentlyAdded.Any())
                {
                    <div class="rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-100 dark:bg-zinc-900 px-6 py-12 text-center text-zinc-400">
                        No recently added anime available.
                    </div>
                }
                else
                {
                    <HorizontalCarousel Items="_recentlyAdded">
                        <ItemTemplate Context="anime">
                            <MediaCard Item="anime" />
                        </ItemTemplate>
                    </HorizontalCarousel>
                }
            </section>

        </div>

        <!-- RIGHT COLUMN (Sidebar - 25% width) -->
        <div class="w-full lg:w-1/4 space-y-6">
            @if (_topAiringLoading)
            {
                <div class="flex items-center justify-center rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-zinc-900/50 py-8">
                    <div class="h-6 w-6 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"></div>
                </div>
            }
            else if (_topAiring.Any())
            {
                <TopTenList Title="Top Airing Anime" Items="_topAiring" />
            }

            @if (_popularLoading)
            {
                <div class="flex items-center justify-center rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-zinc-900/50 py-8">
                    <div class="h-6 w-6 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"></div>
                </div>
            }
            else if (_mostPopular.Any())
            {
                <TopTenList Title="Most Popular" Items="_mostPopular" />
            }
        </div>

    </div>
</div>

@code {
    private List<Media> _recommendedAnime = new();
    private List<Media> _summerAnime = new();
    private List<Media> _recentlyAdded = new();
    private List<RankedMediaItem> _topAiring = new();
    private List<RankedMediaItem> _mostPopular = new();

    private bool _recommendedLoading = true;
    private bool _summerLoading = true;
    private bool _recentLoading = true;
    private bool _topAiringLoading = true;
    private bool _popularLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Fan out all five loads in parallel; each is isolated so a single
        // failing section does not break the rest of the page.
        await Task.WhenAll(
            TryLoadAsync("recommended", async () =>
            {
                _recommendedAnime = await MediaService.GetRecommendedAnimeAsync();
                _recommendedLoading = false;
            }),
            TryLoadAsync("summer", async () =>
            {
                _summerAnime = await MediaService.GetSummerAnimeAsync();
                _summerLoading = false;
            }),
            TryLoadAsync("recent", async () =>
            {
                _recentlyAdded = await MediaService.GetRecentlyAddedAnimeAsync();
                _recentLoading = false;
            }),
            TryLoadAsync("top-airing", async () =>
            {
                _topAiring = await MediaService.GetTopAiringAnimeAsync();
                _topAiringLoading = false;
            }),
            TryLoadAsync("popular", async () =>
            {
                _mostPopular = await MediaService.GetMostPopularAnimeAsync();
                _popularLoading = false;
            })
        );
    }

    private async Task TryLoadAsync(string label, Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Home/{label}] {ex.Message}");
        }
    }
}